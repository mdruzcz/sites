# Per-site identifier — set differently in each Vercel project.
# Used for the site_id column on Supabase rows so one DB hosts all sites.
SITE_ID=

# Sanity — same project across all sites, different dataset per site
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Supabase — same project across all sites; rows scoped via site_id + RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
