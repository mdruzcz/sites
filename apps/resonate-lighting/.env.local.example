# Resonate Lighting - env vars
# Copy to .env.local for local dev; production values live in the Vercel project settings.

# Email notifications (Resend). From address must be on a Resend-verified domain (masterdecker.com is).
RESEND_API_KEY=
CONTACT_TO_EMAIL=service@masterdecker.com
CONTACT_FROM_EMAIL=Resonate Lighting <noreply@masterdecker.com>

# Cloudflare Turnstile (shared Worker - see sites/workers/turnstile-verify/SITE_KEYS.md)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_VERIFY_ENDPOINT=https://turnstile.masterdecker.com

# Shared Supabase relay Worker (hostname -> table map lives in sites/workers/forms-submit)
FORMS_SUBMIT_ENDPOINT=https://forms.masterdecker.com

# Umami self-hosted analytics (optional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
